{
  "name": "dsh-intent-formation",
  "version": "0.3.0-beta.1",
  "private": true,
  "description": "Session-bound Intent Formation policy and local state tools for DeepSeek Harness.",
  "type": "module",
  "main": "dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh/index.js",
    "dsh/adapter.js",
    "dsh/cordis.patch.yml",
    "dsh/tool-catalog.json",
    "dsh/README.md",
    "dsh/SBOM.cdx.json",
    "dsh/THIRD_PARTY_NOTICES.md",
    "packages/intent-formation/src/policy.mjs",
    "plugins/intent-formation-state/LICENSE",
    "plugins/intent-formation-state/NOTICE",
    "plugins/intent-formation-state/THIRD_PARTY_NOTICES.md",
    "plugins/intent-formation-state/dist/intent-formation-server.mjs",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "generate:dsh-catalog": "node dsh/scripts/generate-tool-catalog.mjs",
    "verify:dsh-catalog": "node dsh/scripts/generate-tool-catalog.mjs --check",
    "generate:dsh-legal": "node dsh/scripts/generate-legal.mjs",
    "verify:dsh-legal": "node dsh/scripts/generate-legal.mjs --check",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "verify:release-content": "node scripts/verify-release-content.mjs",
    "test:dsh": "node --test --test-concurrency=1 dsh/tests/adapter.test.mjs",
    "test:dsh-pack": "node dsh/scripts/verify-package.mjs",
    "test": "npm run verify:evidence && npm run verify:release-content && node --test scripts/release-asset-plan.test.mjs scripts/verify-annotated-tag.test.mjs && npm run verify:dsh-catalog && npm run verify:dsh-legal && npm run test:dsh && npm run test:dsh-pack",
    "test:dsh-host": "node dsh/scripts/deepseek-host-smoke.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "@modelcontextprotocol/client": "2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "author": "rrrrrredy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrrrrredy/intent-loop.git"
  },
  "homepage": "https://github.com/rrrrrredy/intent-loop#deepseek-harness",
  "bugs": {
    "url": "https://github.com/rrrrrredy/intent-loop/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "intent-formation",
    "mcp",
    "agent"
  ]
}
