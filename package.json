{
  "name": "dsh-intent-loop",
  "version": "0.2.0-beta.3",
  "description": "Session-scoped Intent Loop tools for DeepSeek Harness, backed by the shared local MCP core.",
  "type": "module",
  "main": "dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh/index.js",
    "dsh/adapter.js",
    "dsh/cordis.patch.yml",
    "dsh/tool-catalog.json",
    "dsh/README.md",
    "dsh/SBOM.cdx.json",
    "dsh/THIRD_PARTY_NOTICES.md",
    "plugins/intent-loop/THIRD_PARTY_NOTICES.md",
    "plugins/intent-loop/runtime/server.mjs",
    "plugins/intent-loop/skills/intent/SKILL.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "generate:dsh-catalog": "node dsh/scripts/generate-tool-catalog.mjs",
    "verify:dsh-catalog": "node dsh/scripts/generate-tool-catalog.mjs --check",
    "generate:dsh-legal": "node dsh/scripts/generate-legal.mjs",
    "verify:dsh-legal": "node dsh/scripts/generate-legal.mjs --check",
    "test:dsh": "node --test --test-concurrency=1 dsh/tests/adapter.test.mjs",
    "test:dsh-pack": "node dsh/scripts/verify-package.mjs",
    "test": "npm run verify:dsh-catalog && npm run verify:dsh-legal && npm run test:dsh && npm run test:dsh-pack",
    "test:dsh-host": "node dsh/scripts/deepseek-host-smoke.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "@modelcontextprotocol/client": "2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "author": "rrrrrredy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrrrrredy/intent-loop.git"
  },
  "homepage": "https://github.com/rrrrrredy/intent-loop#deepseek-harness",
  "bugs": {
    "url": "https://github.com/rrrrrredy/intent-loop/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "intent",
    "mcp",
    "agent"
  ]
}
