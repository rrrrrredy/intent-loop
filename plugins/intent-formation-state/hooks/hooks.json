{
  "description": "Receipt-backed /intent controls and opt-in intent continuity. Hooks never store or echo ordinary prompts; the host maintains atomic records only after state is started.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/intent-resume.mjs\"",
            "timeout": 3,
            "additionalContextLimit": 1500
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/intent-command.mjs\"",
            "timeout": 3,
            "additionalContextLimit": 4000
          }
        ]
      }
    ]
  }
}
